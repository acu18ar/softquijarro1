{
  // Entorno de GitHub Codespaces: todo viene instalado al abrirlo.
  // ⚠️ Archivo del docente.
  "name": "SoftQuijarro (Django)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/preparar.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "SoftQuijarro", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "batisteo.vscode-django"],
      "settings": {
        "files.exclude": { "**/__pycache__": true, "staticfiles": true },
        "git.autofetch": true
      }
    }
  }
}
